diff --git a/pkg/noun/manage.c b/pkg/noun/manage.c
index 433781258d..116d413fe4 100644
--- a/pkg/noun/manage.c
+++ b/pkg/noun/manage.c
@@ -5,6 +5,7 @@
 #include <ctype.h>
 #ifndef U3_OS_windows
 #include <dlfcn.h>
+#include <pthread.h>
 #endif
 #include <errno.h>
 #include <signal.h>
@@ -227,9 +228,35 @@ _cm_signal_handle_over(int x)
 }
 #endif
 
+#ifndef U3_OS_windows
+//  the thread that runs events: u3_Signal is a place on its stack
+//
+static pthread_t u3_Sigted;
+
+/* _cm_signal_pass(): a signal sent to the process is delivered to any
+**                    thread that does not block it, and a jump to u3_Signal
+**                    from another thread's handler is undefined. hand it to
+**                    the event thread instead; say if that was done.
+*/
+static c3_t
+_cm_signal_pass(int sig_i)
+{
+  if ( pthread_equal(pthread_self(), u3_Sigted) ) {
+    return 0;
+  }
+  pthread_kill(u3_Sigted, sig_i);
+  return 1;
+}
+#else
+#  define _cm_signal_pass(sig_i)  (0)   //  rsignal_longjmp() sees to it
+#endif
+
 static void
 _cm_signal_handle_term(int x)
 {
+  if ( _cm_signal_pass(x) ) {
+    return;
+  }
   //  Ignore if we are using base memory from work memory, very rare.
   //
   if ( (0 != u3H->rod_u.kid_p) && (&(u3H->rod_u) == u3R) ) {
@@ -243,6 +270,9 @@ _cm_signal_handle_term(int x)
 static void
 _cm_signal_handle_intr(int x)
 {
+  if ( _cm_signal_pass(x) ) {
+    return;
+  }
   //  Interrupt: stop work.  Ignore if not working, or (rarely) using base.
