+  //  inside +mice the cache is handed to hoon as one map keyed by seed, so
+  //  states are kept there in the one form every runtime shares: no lazy
+  //  compilation, unless the state already depends on it
+  //
+  c3_t eag_t = sat_u->cas_t;
+
