+      CodeArena->laz_t = 1;
+    }
+
     {
       sat_u->yil_previous = u3k(yil_previous);
       sat_u->queue = u3k(queue);
@@ -2240,15 +2431,30 @@ _move_state(
   u3_noun hint,
   u3_noun yil)
 {
+  //  suspended with lazily compiled code that outgrew the arena and is in
