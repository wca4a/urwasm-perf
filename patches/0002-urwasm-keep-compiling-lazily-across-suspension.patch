From e8c78d99d23e3b496ae7518c24eb457119920c35 Mon Sep 17 00:00:00 2001
From: william arzt <bill@tlon.io>
Date: Wed, 25 Nov 2026 11:36:25 -0500
Subject: [PATCH 2/3] urwasm: keep compiling lazily across suspension

A computation suspended on an import holds positions in compiled code, so
that code has to be laid out the same way when the state is loaded again.
Until now that meant compiling the whole module up front for any module
that had ever suspended, which gave up the lazy compile for every program
that uses blocking imports.

Record the order in which functions are compiled (new wasm3 hook) and save
it with a suspended state. On load, compile those functions in that order,
which rebuilds the same layout, then go on compiling lazily. The call that
suspends is no longer run twice, except when its code outgrew the arena.

Such states are cached under their own key, so a runtime without this
change never sees one and recomputes from the seed instead.

Requires the compile hook in urbit/wasm3.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 pkg/noun/jets/e/urwasm.c | 315 +++++++++++++++++++++++++++++++++++----
 1 file changed, 284 insertions(+), 31 deletions(-)

diff --git a/pkg/noun/jets/e/urwasm.c b/pkg/noun/jets/e/urwasm.c
index 1a0161f..a0f1820 100644
--- a/pkg/noun/jets/e/urwasm.c
+++ b/pkg/noun/jets/e/urwasm.c
@@ -106,6 +106,7 @@ typedef struct {
   jmp_buf*  esc_u;  // escape buffer
   c3_t      laz_t;  // lazy code arena: spill into extra chunks, never escape
   c3_w      chk_w;  // number of extra chunks
+  c3_d      tot_d;  // bytes handed out, extra chunks included
   void*     chk_u[UW_CHUNKS];  // extra chunks
 } uw_arena;
 
@@ -205,12 +206,32 @@ static_assert(
   "u3we_run key tag must be a direct atom"
 );
 
+//  memo tag for states suspended with lazily compiled code. these carry
+//  extra data and are kept apart from uw_run_m, so that a runtime that
+//  predates them never sees one: it misses and recomputes from the seed
+static const c3_m uw_ord_m = c3_s4('u','w','o','0');
+
 //  memo tag for the per-context match data
 static const c3_m uw_mat_m = c3_s4('u','w','m','0');
 
-//  modules seen to suspend in this process: compile these eagerly.
-//  a performance hint only, any value here is safe.
-static c3_w _uw_eager_w[256];
+//  code arena size that the lazy calls of a module needed so far, by module
+//  mug. a performance hint only, any value here is safe.
+static struct { c3_w mug_w; c3_h siz_h; } _uw_code_u[256];
+
+#define UW_CODE_MIN  ((c3_h)1 << 20)
+#define UW_CODE_MAX  ((c3_h)1 << 30)
+
+//  smallest power of two that holds byt_d, within [UW_CODE_MIN UW_CODE_MAX]
+static c3_h
+_uw_code_size(c3_d byt_d)
+{
+  c3_h siz_h = UW_CODE_MIN;
+  while ( (siz_h < byt_d) && (siz_h < UW_CODE_MAX) )
+  {
+    siz_h <<= 1;
+  }
+  return siz_h;
+}
 
 //  length without whole trailing zero pages (u3i_bytes strips the rest)
 static c3_w
@@ -270,6 +291,12 @@ typedef struct {
   u3_noun queue;            // transferred
   c3_t is_stateful;
   c3_t laz_t;               // code is compiled on first call, not up front
+  c3_t rec_t;               // record the order functions are compiled in
+  c3_h* ord_h;              // that order, as function indices
+  c3_h orn_h;               // number of entries
+  c3_h orc_h;               // capacity
+  c3_t ork_t;               // the state was loaded from the uw_ord_m cache
+  c3_t cas_t;               // running inside +mice (u3a_flag_cash)
 } lia_state;
 
 typedef enum {
@@ -296,6 +323,7 @@ _uw_arena_init_size(uw_arena* ren_u, c3_h siz_h)
   ren_u->siz_h = siz_h;
   ren_u->laz_t = 0;
   ren_u->chk_w = 0;
+  ren_u->tot_d = 0;
   u3i_slab_init(&ren_u->sab_u, 3, siz_h + 12);  // size + max padding
   ren_u->buf_y = ren_u->nex_y = c3_align(ren_u->sab_u.buf_y, 16, C3_ALGHI);
   ren_u->end_y = ren_u->buf_y + ren_u->siz_h;
@@ -333,6 +361,7 @@ _uw_arena_grow(uw_arena* ren_u)
   u3i_slab_init(&ren_u->sab_u, 3, new_h + 12);  // size + max padding
   ren_u->buf_y = ren_u->nex_y = c3_align(ren_u->sab_u.buf_y, 16, C3_ALGHI);
   ren_u->end_y = ren_u->nex_y + new_h;
+  ren_u->tot_d = 0;
   c3_y pad_y = ren_u->nex_y - ren_u->sab_u.buf_y;
   if (pad_y > 12)
   {
@@ -349,6 +378,7 @@ _uw_arena_reset(uw_arena* ren_u)
     u3m_bail(c3__fail);
   }
   ren_u->nex_y = ren_u->buf_y;
+  ren_u->tot_d = 0;
   memset(ren_u->buf_y, 0, (size_t)ren_u->siz_h);
 }
 
@@ -369,6 +399,49 @@ _uw_arena_free(uw_arena* ren_u)
   ren_u->ini_t = 0;
 }
 
+//  wasm3 calls this at the start of every function compilation.
+//  the layout of compiled code is a function of the order of compilation
+//  alone (nothing else allocates from the code arena), so a lazily compiled
+//  layout can be rebuilt later by compiling the same functions in the same
+//  order. only runtimes loaded by _get_state carry a lia_state here.
+//
+static void
+_uw_compile_hook(IM3Function fun_u, uint32_t idx_h)
+{
+  IM3Module   mod_u = fun_u->module;
+  lia_state*  sat_u = (mod_u && mod_u->runtime) ? mod_u->runtime->userdata
+                                                : NULL;
+  if ( !sat_u || !sat_u->rec_t )
+  {
+    return;
+  }
+  if ( sat_u->orn_h == sat_u->orc_h )
+  {
+    c3_h  new_h = sat_u->orc_h ? (sat_u->orc_h * 2) : 256;
+    c3_h* new_u = u3a_malloc((c3_z)new_h * sizeof(c3_h));
+    if ( sat_u->orn_h )
+    {
+      memcpy(new_u, sat_u->ord_h, (c3_z)sat_u->orn_h * sizeof(c3_h));
+      u3a_free(sat_u->ord_h);
+    }
+    sat_u->ord_h = new_u;
+    sat_u->orc_h = new_h;
+  }
+  sat_u->ord_h[sat_u->orn_h++] = idx_h;
+}
+
+static void
+_uw_order_free(lia_state* sat_u)
+{
+  if ( sat_u->orc_h )
+  {
+    u3a_free(sat_u->ord_h);
+  }
+  sat_u->ord_h = NULL;
+  sat_u->orn_h = sat_u->orc_h = 0;
+  sat_u->rec_t = 0;
+}
+
 static void*
 _calloc_code(size_t num_i, size_t len_i)
 {
@@ -401,8 +474,9 @@ _calloc_code(size_t num_i, size_t len_i)
       _longjmp(*CodeArena->esc_u, c3__code);
     }
     //  lazy mode: this code is discarded before the state is saved, so it
-    //  does not have to be contiguous. spill into a fresh chunk instead of
-    //  moving the arena under running code.
+    //  does not have to be contiguous unless the call ends suspended (the
+    //  caller checks for that). spill into a fresh chunk instead of moving
+    //  the arena under running code.
     //
     if (CodeArena->chk_w >= UW_CHUNKS)
     {
@@ -424,6 +498,7 @@ _calloc_code(size_t num_i, size_t len_i)
   *((c3_d*)lag_v + 1) = byt_d - 16;
 
   CodeArena->nex_y = nex_y;
+  CodeArena->tot_d += byt_d + 16;
   return ((c3_d*)lag_v + 2);
 }
 
@@ -1929,30 +2004,49 @@ _link_wasm_with_arrow_map(
 //    ==
 // seed RETAINED, produces the saved state (or u3_none, or ~ for a tombstone)
 static u3_weak
-_find_state(u3_noun seed)
+_find_tag(c3_m tag_m, u3_noun seed)
 {
-  //  u3_weak get = u3z_find_m(u3z_memo_keep, uw_run_m, seed);
   //  XX order of search matters (sentinel value ~
   //  from previous invocation is closer to the home road)
   //  and u3z_find_m searches from home road down, which is the opposite
   //  of what we want
   //
-  u3_noun key = u3z_key(uw_run_m, seed);
+  u3_noun key = u3z_key(tag_m, seed);
   u3_weak get = u3z_find_up(key);
   u3z(key);
   return get;
 }
 
+static u3_weak
+_find_state(u3_noun seed, c3_t* ork_t)
+{
+  u3_weak get = _find_tag(uw_ord_m, seed);
+  if ( (u3_none != get) && (u3_nul != get) )
+  {
+    *ork_t = 1;
+    return get;
+  }
+  *ork_t = 0;
+  return _find_tag(uw_run_m, seed);
+}
+
 // hint, seed RETAINED; get (a result of _find_state) TRANSFERRED
 // on success allocates sat_u->wasm_module->runtime->memory.mallocated
-// and initializes the arenas
+// and initializes the arenas. siz_h is the size to give a lazy code arena,
