@@ -1993,7 +2087,27 @@ _get_state(u3_noun hint,
       ? pad_box
       : u3m_bail(c3__fail);
     
-    c3_h run_off_h = (u3a_direct_max_h > runtime_offset)
+    //  a computation that was suspended with lazily compiled code is saved
+    //  (under uw_ord_m) as [runtime-offset count order used]: the functions
+    //  that were compiled, in order, and the size of the code they made.
+    //
+    c3_t    ord_t = (c3y == u3du(runtime_offset));
+    u3_noun ord_num = 0, ord_dat = 0, ord_use = 0;
+    if ( ord_t )
+    {
+      u3_noun ord = u3t(runtime_offset);
+      runtime_offset = u3h(runtime_offset);
+      if (  (c3n == u3r_trel(ord, &ord_num, &ord_dat, &ord_use))
+         || (c3n == u3a_is_cat(ord_num))
+         || (c3n == u3ud(ord_dat))
+         || (c3n == u3a_is_cat(ord_use)) )
+      {
+        return u3m_bail(c3__fail);
+      }
+    }
+
+    c3_h run_off_h = ( (c3y == u3ud(runtime_offset))
+                     && (u3a_direct_max_h > runtime_offset) )
       ? runtime_offset
       : u3m_bail(c3__fail);
     
@@ -2010,15 +2124,30 @@ _get_state(u3_noun hint,
     M3Result result;
     IM3Runtime wasm3_runtime = (IM3Runtime)(BoxArena->buf_y + run_off_h);
 
-    //  a suspended computation holds positions in compiled code, which are
-    //  only reproducible if everything is compiled up front in a fixed order
+    //  a suspended computation holds positions in compiled code, so that
+    //  code has to be rebuilt exactly as it was: either everything in index
+    //  order (it was suspended after compiling everything up front), or the
+    //  recorded functions in the recorded order.
     //
-    laz_t = laz_t && (0 == wasm3_runtime->edge_suspend);
+    c3_t sus_t = (0 != wasm3_runtime->edge_suspend);
+    c3_t laz_t = (!sus_t && !eag_t) || ord_t;
+    if ( !sus_t && ord_t )
+    {
+      return u3m_bail(c3__fail);
+    }
     sat_u->laz_t = laz_t;
+    sat_u->rec_t = 0;
+    sat_u->ord_h = NULL;
+    sat_u->orn_h = sat_u->orc_h = 0;
     if (laz_t)
     {
-      _uw_arena_init_size(CodeArena, (c3_h)1 << 20);
-      CodeArena->laz_t = 1;
+      //  the code to rebuild must fit without spilling: it is contiguous
+      //
+      //  (what runs after that may spill)
+      //
+      c3_h min_h = ord_t ? _uw_code_size((c3_d)ord_use + (1 << 16))
+                         : UW_CODE_MIN;
+      _uw_arena_init_size(CodeArena, c3_max(min_h, siz_h));
     }
     else
     {
@@ -2029,6 +2158,8 @@ _get_state(u3_noun hint,
     m3_RewritePointersRuntime(wasm3_runtime, BoxArena->buf_y, 0 /*is_store*/);
     IM3Module wasm3_module = wasm3_runtime->modules;
     c3_h n_imports = wasm3_module->numFuncImports;
+    wasm3_runtime->userdata = sat_u;  //  for _uw_compile_hook
+    sat_u->rec_t = laz_t;
 
     // make sure to not touch BoxArena
     m3_SetAllocators(_calloc_bail, _free_bail, _realloc_bail);
@@ -2064,7 +2195,28 @@ _get_state(u3_noun hint,
           }
         }
 
-        result = laz_t ? m3Err_none : m3_CompileModule(wasm3_module);
+        if ( !laz_t )
+        {
+          result = m3_CompileModule(wasm3_module);
+        }
+        else
+        {
+          //  rebuild the code of a suspended computation
+          //
+          c3_h ord_h;
+          result = m3Err_none;
+          for (c3_h i = 0; !result && (i < (c3_h)ord_num); i++)
+          {
+            ord_h = 0;
+            u3r_bytes(4 * i, 4, (c3_y*)&ord_h, ord_dat);
+            if (  (ord_h >= wasm3_module->numFunctions)
+               || wasm3_module->functions[ord_h].compiled )
+            {
+              return u3m_bail(c3__fail);
+            }
+            result = CompileFunction(&wasm3_module->functions[ord_h]);
+          }
+        }
         if (result)
         {
           fprintf(stderr, ERR("compilation error: %s"), result);
@@ -2075,7 +2227,23 @@ _get_state(u3_noun hint,
       }
       else
       {
-        if (jmp_i == c3__code)
+        if ( (jmp_i == c3__code) && laz_t )
+        {
+          //  the lazy arena is too small even to set up (import stubs, the
+          //  code of a suspended computation). start over from the saved
+          //  state with twice the room
+          //
+          c3_h big_h = CodeArena->siz_h;
+          if ( big_h >= UW_CODE_MAX )
+          {
+            return u3m_bail(c3__fail);
+          }
+          _uw_order_free(sat_u);
+          _uw_arena_free(CodeArena);
+          _uw_arena_free(BoxArena);
+          return _get_state(hint, seed, sat_u, big_h * 2, get);
+        }
+        else if (jmp_i == c3__code)
         {
           _uw_arena_grow(CodeArena);
         }
@@ -2087,6 +2255,29 @@ _get_state(u3_noun hint,
       }
     }
 
+    if ( laz_t )
+    {
+      if (  ord_t
+         && (  ((c3_h)ord_num != sat_u->orn_h)
+            || ((c3_d)ord_use != (c3_d)(CodeArena->nex_y - CodeArena->buf_y)) ) )
+      {
+        //  the rebuilt code is not laid out like the code the computation
+        //  was suspended in: its saved positions cannot be trusted.
+        //  drop this state, the caller recomputes it from the seed
+        //
+        fprintf(stderr, WUT("suspended code layout mismatch, recomputing"));
+        _uw_order_free(sat_u);
+        sat_u->laz_t = 0;
+        _uw_arena_free(CodeArena);
+        _uw_arena_free(BoxArena);
+        u3z(get);
+        return 0;
+      }
+      //  from here on code is compiled while wasm runs: never move it
