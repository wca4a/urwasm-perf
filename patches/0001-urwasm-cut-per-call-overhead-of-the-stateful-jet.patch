   ren_u->buf_y = ren_u->nex_y = c3_align(ren_u->sab_u.buf_y, 16, C3_ALGHI);
   ren_u->end_y = ren_u->buf_y + ren_u->siz_h;
@@ -331,6 +360,12 @@ _uw_arena_free(uw_arena* ren_u)
     u3m_bail(c3__fail);
   }
   u3i_slab_free(&ren_u->sab_u);
+  for (c3_w i = 0; i < ren_u->chk_w; i++)
+  {
+    u3a_free(ren_u->chk_u[i]);
+  }
+  ren_u->chk_w = 0;
+  ren_u->laz_t = 0;
   ren_u->ini_t = 0;
 }
 
@@ -360,8 +395,29 @@ _calloc_code(size_t num_i, size_t len_i)
   nex_y = c3_align(nex_y, 16, C3_ALGHI);
   
   if (nex_y >= CodeArena->end_y)
-  { // OOM, jump out to increase the arena size and try again
-    _longjmp(*CodeArena->esc_u, c3__code);
+  {
+    if (!CodeArena->laz_t)
+    { // OOM, jump out to increase the arena size and try again
+      _longjmp(*CodeArena->esc_u, c3__code);
+    }
+    //  lazy mode: this code is discarded before the state is saved, so it
+    //  does not have to be contiguous. spill into a fresh chunk instead of
+    //  moving the arena under running code.
+    //
+    if (CodeArena->chk_w >= UW_CHUNKS)
+    {
+      u3m_bail(c3__fail);
+    }
+    c3_d siz_d = (c3_d)1 << (20 + c3_min(CodeArena->chk_w, 8));
+    if (siz_d < byt_d + 64)
+    {
+      siz_d = byt_d + 64;
+    }
+    c3_y* chk_y = u3a_calloc(1, siz_d);
+    CodeArena->chk_u[CodeArena->chk_w++] = chk_y;
+    lag_v = c3_align(chk_y, 16, C3_ALGHI);
+    CodeArena->end_y = chk_y + siz_d;
+    nex_y = c3_align((c3_y*)lag_v + byt_d, 16, C3_ALGHI);
   }
 
   *((c3_d*)lag_v) = byt_d - 16;  // corruption check
