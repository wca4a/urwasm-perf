@@ -92,6 +92,8 @@ uw_slam_nock(u3_noun gat, u3_noun sam)
   return uw_kick_nock(cor, 2);
 }
 
+#define UW_CHUNKS  40
+
 // memory arena with exponential growth
 typedef struct {
   c3_h      siz_h;  // size in bytes
@@ -102,6 +104,9 @@ typedef struct {
   c3_y*     nex_y;  // next allocation
   c3_y*     end_y;  // end of arena
   jmp_buf*  esc_u;  // escape buffer
+  c3_t      laz_t;  // lazy code arena: spill into extra chunks, never escape
+  c3_w      chk_w;  // number of extra chunks
+  void*     chk_u[UW_CHUNKS];  // extra chunks
 } uw_arena;
 
 // Struct/array allocation: [len_d cap_d data]
@@ -200,6 +205,25 @@ static_assert(
   "u3we_run key tag must be a direct atom"
 );
 
+//  memo tag for the per-context match data
+static const c3_m uw_mat_m = c3_s4('u','w','m','0');
+
+//  modules seen to suspend in this process: compile these eagerly.
+//  a performance hint only, any value here is safe.
+static c3_w _uw_eager_w[256];
+
+//  length without whole trailing zero pages (u3i_bytes strips the rest)
+static c3_w
+_uw_trim(const c3_y* buf_y, c3_w len_w)
+{
+  static const c3_y zer_y[4096];
+  while ( (len_w >= 4096) && (0 == memcmp(buf_y + len_w - 4096, zer_y, 4096)) )
+  {
+    len_w -= 4096;
+  }
+  return len_w;
+}
+
 typedef struct {
   u3_noun call_bat;
   u3_noun memread_bat;
@@ -229,6 +253,8 @@ typedef struct {
   u3_noun set_all_glob_ctx;
 } match_data_struct;
 
+#define UW_MATCH_LEN  (sizeof(match_data_struct) / sizeof(u3_noun))
+
 typedef struct {
   IM3Module wasm_module;    // p
   u3_noun lia_shop;         // q,   transferred
@@ -243,6 +269,7 @@ typedef struct {
   u3_noun yil_previous;     // transferred
   u3_noun queue;            // transferred
   c3_t is_stateful;
+  c3_t laz_t;               // code is compiled on first call, not up front
 } lia_state;
 
 typedef enum {
@@ -267,6 +294,8 @@ static void
 _uw_arena_init_size(uw_arena* ren_u, c3_h siz_h)
 {
   ren_u->siz_h = siz_h;
+  ren_u->laz_t = 0;
+  ren_u->chk_w = 0;
