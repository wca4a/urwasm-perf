-  if ( hot_u->cod_y ) munmap(hot_u->cod_y, UW_HOT_CODE);
-  if ( hot_u->mem_v ) munmap(hot_u->mem_v, UW_HOT_MAP);
-  if ( hot_u->fun_v ) free(hot_u->fun_v);
-  if ( hot_u->sat_u.orc_h ) free(hot_u->sat_u.ord_h);
+  _uw_hot_hold();
+  c3_y*  box_y = hot_u->box_y;
+  c3_y*  cod_y = hot_u->cod_y;
+  void*  mem_v = hot_u->mem_v;
+  void** fun_v = hot_u->fun_v;
+  c3_h*  ord_h = hot_u->sat_u.orc_h ? hot_u->sat_u.ord_h : NULL;
+  hot_u->sat_y = 0;
+  hot_u->idh_d = hot_u->idl_d = 0;
   hot_u->box_y = hot_u->cod_y = NULL;
   hot_u->mem_v = NULL;
+  hot_u->mec_d = 0;
   hot_u->fun_v = NULL;
   hot_u->fun_d = 0;
   hot_u->sat_u.ord_h = NULL;
   hot_u->sat_u.orn_h = hot_u->sat_u.orc_h = 0;
   hot_u->sat_u.rec_t = 0;
-  hot_u->idh_d = hot_u->idl_d = 0;
-  hot_u->sat_y = 0;
+  if ( box_y ) free(box_y);
+  if ( cod_y ) munmap(cod_y, UW_HOT_CODE);
+  if ( mem_v ) munmap(mem_v, UW_HOT_MAP);
+  if ( fun_v ) free(fun_v);
+  if ( ord_h ) free(ord_h);
+  _uw_hot_move();
 }
 
 //  the ready instance with this id, if any
@@ -557,32 +611,36 @@ _uw_hot_size(uw_hot* hot_u)
        + (c3_d)hot_u->sat_u.orc_h * sizeof(c3_h);
 }
 
-//  an empty slot to build an instance of ned_d bytes in, or NULL. now_v is
-//  an address in the caller's frame. the least recently used instances make
-//  way, for the slot and for the total, but only if that is enough: nothing
-//  is dropped for an instance that cannot be kept anyway.
-static uw_hot*
-_uw_hot_take(void* now_v, c3_d ned_d)
+//  bytes held by the instances calls are running on (they cannot make way),
+//  and how many there are. a running instance belongs to a call further up
+//  this stack: one a bail came out of was dropped by that call, and one an
+//  aborted event left behind was dropped by u3we_lia_reap()
+static c3_d
+_uw_hot_busy(c3_w* bus_w)
 {
-  c3_d bus_d = ned_d;   //  with what cannot make way: instances in use
-  c3_w bus_w = 0;
+  c3_d bus_d = 0;
+  *bus_w = 0;
   for (c3_w i = 0; i < UW_HOT; i++)
   {
     uw_hot* hot_u = &_uw_hot_u[i];
-    //  marked running, by a frame that cannot still exist: a frame that
-    //  called us would be above us on the stack. (a bail is caught and
-    //  cleans up; this is for an event aborted by a signal, which is not.)
-    //
-    if ( (2 == hot_u->sat_y) && ((c3_p)now_v >= (c3_p)hot_u->own_v) )
-    {
-      _uw_hot_free(hot_u);
-    }
     if ( 2 == hot_u->sat_y )
     {
       bus_d += _uw_hot_size(hot_u);
-      bus_w++;
+      (*bus_w)++;
     }
   }
+  return bus_d;
+}
+
+//  an empty slot to build an instance of ned_d bytes in, or NULL. the least
+//  recently used instances make way, for the slot and for the total, but
+//  only if that is enough: nothing is dropped for an instance that cannot
+//  be kept anyway.
+static uw_hot*
+_uw_hot_take(c3_d ned_d)
+{
+  c3_w bus_w;
+  c3_d bus_d = ned_d + _uw_hot_busy(&bus_w);
   if ( (bus_d > UW_HOT_ALL) || (UW_HOT == bus_w) )
   {
     return NULL;
@@ -642,30 +700,57 @@ _uw_hot_trim(void)
 static c3_t
 _uw_hot_room(uw_hot* hot_u, c3_h box_h)
 {
+  _uw_hot_hold();
   hot_u->box_y = malloc(box_h ? box_h : 1);
   hot_u->box_h = box_h;
-  hot_u->cod_y = mmap(NULL, UW_HOT_CODE, PROT_READ | PROT_WRITE,
+  hot_u->cod_y = mmap(NULL, UW_HOT_CODE, PROT_NONE,
                       MAP_PRIVATE | MAP_ANON, -1, 0);
-  hot_u->mem_v = mmap(NULL, UW_HOT_MAP, PROT_READ | PROT_WRITE,
+  hot_u->mem_v = mmap(NULL, UW_HOT_MAP, PROT_NONE,
                       MAP_PRIVATE | MAP_ANON, -1, 0);
+  hot_u->mec_d = 0;
   if ( MAP_FAILED == (void*)hot_u->cod_y ) hot_u->cod_y = NULL;
   if ( MAP_FAILED == hot_u->mem_v ) hot_u->mem_v = NULL;
   if ( !hot_u->box_y || !hot_u->cod_y || !hot_u->mem_v )
   {
     _uw_hot_free(hot_u);
+    _uw_hot_move();
     return 0;
   }
+  _uw_hot_move();
+  return 1;
+}
+
+//  make the first len_d bytes of a reservation of max_d bytes at bas_y
+//  usable, of which *com_d bytes already are
+static c3_t
+_uw_hot_open(c3_y* bas_y, c3_d* com_d, c3_d len_d, c3_d max_d)
+{
+  if ( len_d <= *com_d ) return 1;
+  if ( len_d > max_d ) return 0;
+  c3_d new_d = c3_min((len_d + UW_HOT_STEP - 1) & ~(UW_HOT_STEP - 1), max_d);
+  if ( 0 != mprotect(bas_y + *com_d, (size_t)(new_d - *com_d),
+                     PROT_READ | PROT_WRITE) )
+  {
+    return 0;
+  }
+  *com_d = new_d;
   return 1;
 }
 
 //  the reserved room is all the wasm memory a module can have, and all the
-//  code an arena can describe, so these do not run out in practice
+//  code an arena can describe, so these do not run out in practice. if the
+//  system will not back what is used, that is the same as the loom running
+//  out on the ordinary path: bail, rather than fail the wasm memory.grow
 //
 static void*
 _uw_hot_calloc(size_t num_i, size_t len_i)
 {
   size_t byt_i = num_i * len_i;
   if ( !_uw_hot_cur || (byt_i > UW_HOT_MAP) ) return NULL;
+  if ( !_uw_hot_open(_uw_hot_cur->mem_v, &_uw_hot_cur->mec_d, byt_i, UW_HOT_MAP) )
+  {
+    u3m_bail(c3__meme);
+  }
   memset(_uw_hot_cur->mem_v, 0, byt_i);
   return _uw_hot_cur->mem_v;
 }
@@ -680,11 +765,39 @@ static void*
 _uw_hot_realloc(void* ptr_v, size_t old_i, size_t new_i)
 {
   if ( !_uw_hot_cur || (new_i > UW_HOT_MAP) ) return NULL;
+  if ( !_uw_hot_open(_uw_hot_cur->mem_v, &_uw_hot_cur->mec_d, new_i, UW_HOT_MAP) )
+  {
+    u3m_bail(c3__meme);
+  }
   if ( !ptr_v ) memset(_uw_hot_cur->mem_v, 0, new_i);
   return _uw_hot_cur->mem_v;
 }
 #endif
 
+//  an event aborted by a signal (see u3m_soft_top) never comes back to the
+//  calls it cut short, so nothing else would release the instances they
+//  were running on: drop them. called after the jump out, when the signals
+//  are no longer handled.
+//
+void
+u3we_lia_reap(void)
+{
+#if UW_HOT
+  //  an abort out of a hold (a stack overflow, say) restored the signal
+  //  mask but not the count
+  //
+  _uw_hot_hol_w = 0;
+  _uw_hot_cur = NULL;
+  for (c3_w i = 0; i < UW_HOT; i++)
+  {
+    if ( 1 != _uw_hot_u[i].sat_y )
+    {
+      _uw_hot_free(&_uw_hot_u[i]);
+    }
+  }
+#endif
+}
