+static c3_w      _uw_hot_hol_w;  //  depth of _uw_hot_hold()
+static sigset_t  _uw_hot_old_s;  //  signal mask before it
+
+//  the signals that abort an event (SIGINT, SIGTERM, SIGVTALRM: see
+//  u3m_soft_top) longjmp out of whatever is running. hold them off while
+//  the C heap is in use or a slot changes hands: a jump out of malloc() or
+//  free() could leave the heap locked or broken, and one out of a half-done
+//  change could leave a slot pointing at freed memory. a held signal
+//  arrives at _uw_hot_move(). nothing in between may bail: a bail would
+//  leave them held. holds nest.
+//
+static void
+_uw_hot_hold(void)
+{
+  if ( !_uw_hot_hol_w )
+  {
+    sigset_t set_s;
+    sigemptyset(&set_s);
+    sigaddset(&set_s, SIGINT);
+    sigaddset(&set_s, SIGTERM);
+    sigaddset(&set_s, SIGVTALRM);
+    pthread_sigmask(SIG_BLOCK, &set_s, &_uw_hot_old_s);
+  }
+  _uw_hot_hol_w++;
+}
+
+static void
+_uw_hot_move(void)
+{
+  if ( !--_uw_hot_hol_w )
+  {
+    pthread_sigmask(SIG_SETMASK, &_uw_hot_old_s, NULL);
+  }
+}
