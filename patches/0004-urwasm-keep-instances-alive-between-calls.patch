@@ -2493,7 +2843,11 @@ _move_state(
   u3_atom q_buf = u3i_bytes(_uw_trim((c3_y*)(mem_u + 1), len_buf_w),
                             (c3_y*)(mem_u + 1));
 
-  u3a_free(mem_u);
